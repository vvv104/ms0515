        .TITLE  FLOAD
;-------------------------------------------------------------------
; FLOAD - the loader FIST ships as its .SAV.
;
; An RT-11 .SAV is a memory image from address 0, so every hole in the
; program's address map is stored on disk.  FIST's image is 38400 bytes
; of which 11194 are holes and buffers it never reads, so the program
; travels in FIST.DAT instead (source/pack_fist.py appends it there,
; LZSS-packed) and this reads it back.  The regions follow each other
; byte for byte and the table sits at the very end of the file:
;
;       (load address, word count, start block, byte offset into it,
;       packed length) per region, then the image's top - what this
;       clears up to - and the count as the last word
;
; and .LOOKUP hands back the file's length, so nothing here has to be
; told where the table is.
;
; The one awkward part: the program's own code lands at 01000, where
; this loader runs.  So every other region goes first, then the unpacker
; and the finisher are copied into the hole and they place the last
; region over us and enter the game.  Both use only registers, constants
; and the stack, so they run at whatever address they are copied to.
;-------------------------------------------------------------------
        .MCALL  .LOOKUP,.PRINT,.EXIT,.SETTOP
        .ASECT
        . = 44
        .WORD   21000                  ; JSW: this .SAV does file I/O
        . = 1000

; The whole working set sits in the hole between the game's regions -
; 057574..077777, which the game never touches and which is below
; RT-11's resident monitor.  Above the monitor is not free: the game
; opens FIST.DAT itself, so RT-11 has to survive until it starts.
HOLE   = 57600                         ; the unpacker, then the finisher
TABBUF = 60100                         ; the table block is read here - a WHOLE
                                       ;   block below SCRAT, because the table's
                                       ;   entries are at its end and the scratch
                                       ;   would otherwise land on them
SCRAT  = 61100                         ; packed regions land here to be expanded
STACK  = 77776                         ; above them all, still in the hole
; The scratch holds a region's packed form plus its offset into the first
; block, rounded up to whole blocks: pack_fist.MAX_REGION keeps that under
; STACK-SCRAT.
SYSC   = 177604                        ; System Register C (border + video mode)
DISPAT = 177400                        ; the memory dispatcher
VRAM   = 40000                         ; the VRAM window, banks 2-3
TVIDEO = 3377                          ; VRAM on at 040000, banks 4-6 primary
LMARG  = 8.                            ; the picture is 256 px in 320: 8 bytes in
TMARG  = 4.                            ;   and 192 lines in 200: 4 lines down
LSTRID = 80.                           ; bytes per VRAM line
RDW    = 4001                          ; .READW, channel 1 (code 8 in the high byte)
CLOSE  = 3001                          ; .CLOSE, channel 1 (code 6)
; Channel 1, not 0: the game opens 0 for itself the moment it starts, and
; a channel still in use would fail its .LOOKUP.

START:  MOV     #STACK,SP
        JSR     PC,TITLE1              ; the picture, before anything is read
        .LOOKUP #LKAREA,#1,#DATFIL
        BCC     1$
        JMP     ERR
1$:     DEC     R0                     ; R0 = the file's length; the table is last
        MOV     #TABBUF,R1
        MOV     #256.,R2
        MOV     R0,R3
        JSR     PC,READ                ; the table block

        ; Low memory is the monitor's: the words the image carries below
        ; 01000 are LINK's own bookkeeping (start address, high limit, JSW)
        ; and RT-11 sets them when it loads a .SAV.  Clearing them here took
        ; 054 - the pointer to RMON - with them, and the next EMT went
        ; nowhere.  So low memory is neither cleared nor loaded.
        MOV     #LOADND,R0
        MOV     #HOLE,R1
        JSR     PC,ZERO
        MOV     #100000,R0
        MOV     TABBUF+774,R1          ; the image's top, from the table: the
        JSR     PC,ZERO                ;   buffers up there are .BLKB, never
                                       ;   stored, and the game wants them zero

        ; The unpacker and the finisher into the hole, before any region
        ; needs expanding.
        MOV     #PIC,R0
        MOV     #HOLE,R1
        MOV     #<PICEND-PIC>/2,R2
2$:     MOV     (R0)+,(R1)+
        SOB     R2,2$

        ; The count is the table block's last word and the entries are the
        ; ten bytes each in front of it.
        MOV     #TABBUF+774,R4         ; the top; the count is the word after
        MOV     2(R4),R5               ; the region count
        MOV     R5,R0
        ASL     R0                     ; 2n
        MOV     R0,R1
        ASL     R1
        ASL     R1                     ; 8n
        ADD     R1,R0                  ; 10n - the entries' length in bytes
        SUB     R0,R4                  ; the first entry

        ; Every region but the one that covers this loader.  That one is
        ; remembered by its entry: the table block outlives the loader, so
        ; there is no need to copy the five words out of it.
3$:     MOV     R4,ENT
        MOV     (R4)+,EADR
        MOV     (R4)+,ECNT
        MOV     (R4)+,EBLK
        MOV     (R4)+,EOFF
        MOV     (R4)+,ELEN
        CMP     EADR,#1000
        BLO     5$                     ; below 01000: the monitor's, leave it
        BNE     4$
        MOV     ENT,KENT               ; ours: it goes last, from the hole
        BR      5$
4$:     MOV     R4,-(SP)               ; the unpacker uses every register,
        MOV     R5,-(SP)               ;   and these two are the table walk
        JSR     PC,PLACE
        MOV     (SP)+,R5
        MOV     (SP)+,R4
5$:     SOB     R5,3$

        ; Into the finisher, with the last region in the registers.
        MOV     KENT,R0
        MOV     (R0)+,R2               ; load address
        MOV     (R0)+,R3               ; word count
        MOV     (R0)+,R1               ; start block
        MOV     (R0)+,R5               ; byte offset into it
        MOV     (R0),R4                ; packed length
        JMP     @#HOLE+<FIN-PIC>

        ; PLACE: the region described by the E cells, read aside and expanded.
PLACE:  MOV     EOFF,R3
        ADD     ELEN,R3
        ADD     #511.,R3
        BIC     #777,R3                ; up to a whole number of blocks
        ASR     R3                     ; as words
        MOV     R3,R2
        MOV     EBLK,R3
        MOV     #SCRAT,R1
        JSR     PC,READ
        MOV     #SCRAT,R1
        ADD     EOFF,R1                ; the packed bytes start here
        MOV     EADR,R2
        MOV     ECNT,R3
        ASL     R3                     ;   as bytes
        JMP     @#HOLE                 ; the unpacker returns to our caller

        ; READ: R1 = buffer, R2 = words, R3 = block.  Keeps R4/R5.
READ:   MOV     R4,-(SP)
        MOV     R5,-(SP)
        MOV     #LKAREA,R5
        MOV     #RDW,(R5)
        MOV     R3,2(R5)
        MOV     R1,4(R5)
        MOV     R2,6(R5)
        CLR     10(R5)
        MOV     R5,R0
        EMT     375
        BCS     7$
        MOV     (SP)+,R5
        MOV     (SP)+,R4
        RTS     PC
7$:     JMP     ERR

        ; TITLE1: expand the packed loading screen above our own image
        ; and convert it into VRAM.  RT-11 owns no part of either: the
        ; buffer is memory .SETTOP asked for, and VRAM is the video
        ; hardware's, so the picture stays up through the whole load.
TITLE1: .SETTOP #PICBUF+SCRRAW
        CMP     R0,#PICBUF+SCRRAW      ; did we get it?  R0 = the real top
        BLO     18$                    ;   no: skip the picture, still load
        MOV     #SCRPK,R1
        MOV     #PICBUF,R2
        MOV     #SCRRAW,R3
        JSR     PC,PIC                 ; the decoder, still in our own image
        MTPS    #340
        MOVB    @#SYSC,R0
        BIC     #17,R0                 ; medium resolution, colour
        MOVB    R0,@#SYSC
        MOV     #TVIDEO,@#DISPAT
        MOV     #VRAM,R0               ; the window is ours now: the cyan
16$:    MOV     #24000,(R0)+           ;   border the game paints (BORDER),
        CMP     R0,#VRAM+16384.        ;   and the picture goes over it
        BLO     16$
        CLR     R5                     ; R5 = the Spectrum line, 0..191
17$:    MOV     R5,R0
        JSR     PC,ROWOFF              ; R1 = the line's offset in the pixels
        ADD     #PICBUF,R1
        MOV     R5,R2                  ; the attribute row: 6144 + (y>>3)*32
        ASR     R2
        ASR     R2
        ASR     R2
        ASL     R2
        ASL     R2
        ASL     R2
        ASL     R2
        ASL     R2
        ADD     #PICBUF+6144.,R2
        MOV     R5,R3                  ; the VRAM line: (TMARG + y) * 80
        ADD     #TMARG,R3
        MOV     R3,R0
        ASL     R0
        ASL     R0
        ASL     R0
        ASL     R0                     ; * 16
        MOV     R0,R4
        ASL     R0
        ASL     R0                     ; * 64
        ADD     R4,R0                  ; * 80
        ADD     #VRAM+LMARG,R0
        MOV     R0,R3
        MOV     #32.,R4                ; 32 cells across
15$:    CLR     R0
        BISB    (R2)+,R0
        SWAB    R0                     ; the attribute is the high byte
        BISB    (R1)+,R0               ;   and the pixels the low one
        MOV     R0,(R3)+
        DEC     R4
        BNE     15$
        INC     R5
        CMP     R5,#192.
        BLO     17$
        MOV     #3177,@#DISPAT         ; the window off again; the picture stays
        MTPS    #0
18$:    RTS     PC

        ; ROWOFF: R0 = the Spectrum line, R1 = its offset in the pixel area.
ROWOFF: MOV     R0,R1
        BIC     #177770,R1
        SWAB    R1                     ; (y & 7) << 8
        MOV     R0,-(SP)
        BIC     #177707,(SP)
        ASL     (SP)
        ASL     (SP)
        BIS     (SP)+,R1               ; | (y & 070) << 2
        MOV     R0,-(SP)
        BIC     #177477,(SP)
        ASL     (SP)
        ASL     (SP)
        ASL     (SP)
        ASL     (SP)
        ASL     (SP)
        BIS     (SP)+,R1               ; | (y & 0300) << 5
        RTS     PC

        ; ZERO: R0 = from, R1 = to (exclusive).
ZERO:   CMP     R0,R1
        BHIS    8$
        CLR     (R0)+
        BR      ZERO
8$:     RTS     PC

ERR:    .PRINT  #EMSG
        .EXIT

;-------------------------------------------------------------------
; Copied to HOLE and run there: registers, constants and the stack only.
;-------------------------------------------------------------------
        ; The unpacker, entered at HOLE: R1 = packed bytes, R2 = where to
        ; put them, R3 = bytes to produce.  LZSS - a flag byte, then eight
        ; items, low bit first: a set bit is a literal byte, a clear one
        ; two bytes giving a distance of up to 4095 and a length of 3..18.
        ; A match copies from what is already written, so a run comes out
        ; by itself.
PIC:    TST     R3
        BEQ     19$
11$:    CLR     R5
        BISB    (R1)+,R5
        BIS     #400,R5                ; a sentinel above the eight flags
12$:    ASR     R5                     ; C = this item's flag
        BCC     13$
        MOVB    (R1)+,(R2)+            ; a literal byte
        DEC     R3
        BR      18$
13$:    CLR     R0
        BISB    (R1)+,R0               ; the distance, low eight bits
        CLR     R4
        BISB    (R1)+,R4               ; its top four, and the length
        MOV     R4,-(SP)
        BIC     #177417,R4             ; the high nibble alone
        ASL     R4
        ASL     R4
        ASL     R4
        ASL     R4                     ; into bits 11..8
        ADD     R4,R0                  ; R0 = the distance
        MOV     (SP)+,R4
        BIC     #177760,R4             ; the length nibble
        ADD     #3,R4                  ; 3..18
        MOV     R2,-(SP)
        SUB     R0,(SP)
        MOV     (SP)+,R0               ; where to copy from
14$:    MOVB    (R0)+,(R2)+
        DEC     R3
        BEQ     19$
        SOB     R4,14$
18$:    TST     R3
        BEQ     19$
        CMP     R5,#1                  ; the sentinel down to bit 0: eight done
        BNE     12$
        BR      11$
19$:    RTS     PC

        ; The finisher: R1 = block, R2 = load address, R3 = word count,
        ; R4 = packed length, R5 = byte offset into the block.  The K cells
        ; live in the image this is about to overwrite, so everything it
        ; needs is in registers and on the stack.
FIN:    MOV     R5,R0
        ADD     R4,R0
        ADD     #511.,R0
        BIC     #777,R0
        ASR     R0                     ; words to read
        MOV     R3,-(SP)               ; the region's word count
        MOV     R2,-(SP)               ;   and where it belongs
        MOV     R5,-(SP)               ;   and the offset
        CLR     -(SP)
        MOV     R0,-(SP)
        MOV     #SCRAT,-(SP)
        MOV     R1,-(SP)
        MOV     #RDW,-(SP)
        MOV     SP,R0
        EMT     375
        ADD     #12,SP                 ; drop the five-word argument block
        MOV     (SP)+,R1               ; the offset
        ADD     #SCRAT,R1              ;   into the scratch
        MOV     (SP)+,R2
        MOV     (SP)+,R3
        ASL     R3                     ; the region's bytes
        JSR     PC,@#HOLE              ; expand it over this loader
        MOV     #CLOSE,-(SP)
        MOV     SP,R0
        EMT     375                    ; the game opens the channel itself
        TST     (SP)+
        JMP     @#1000                 ; into the game
PICEND:

EADR:   .WORD   0
ECNT:   .WORD   0
EBLK:   .WORD   0
EOFF:   .WORD   0
ELEN:   .WORD   0
ENT:    .WORD   0
KENT:   .WORD   0
        .EVEN
DATFIL: .RAD50  /DK FIST  DAT/
        .EVEN
LKAREA: .BLKW   5
EMSG:   .ASCIZ  /?FLOAD-F-Cannot read FIST.DAT/
        .EVEN
LOADND:
; The picture's packed bytes follow, from FSCRN.MAC, and it ends the
; assembly: `.END` here would cut them off.  It also defines PICBUF, the
; buffer above the image that the picture expands into.
