PROGRAM MINESWEEPER;
   CONST
	MAXNUMSPR=62;
   TYPE
	WORD=0..65535;
	ZNKP=-1..28;
	POLE=ARRAY[0..41,0..21] OF ZNKP;
	SPRT=ARRAY[0..7] OF WORD;
	TOFSPRT=ARRAY[0..MAXNUMSPR] OF SPRT;
	NAME=ARRAY[1..6] OF CHAR;
   VAR
	NEWP,MARK,QUIT:BOOLEAN;
        S:TOFSPRT;
	A:POLE;
        FILNAME:NAME;
        PGP,NGP,KM:INTEGER;
	KPPM,KNPM,KOK:INTEGER;
        XMIN,XMAX,YMIN,YMAX,X,Y:INTEGER;
	SEED1,SEED2,I,J,K,N,XP,YP:INTEGER;
	INK:INTEGER;

{---------------------------------------------------------------}
Procedure SetBorder    (C:integer);			EXTERNAL;
Procedure KbMode       (mode:integer);			EXTERNAL;
Procedure ClrScr;					EXTERNAL;
Procedure GotoXY       (x, y: integer);			EXTERNAL;
Procedure CurOff;					EXTERNAL;
Procedure CurOn;					EXTERNAL;
Function  Inkey:integer;				EXTERNAL;
PROCEDURE CHECK(CONC:INTEGER;FILNAM:NAME;VAR S:TOFSPRT);	EXTERNAL;
PROCEDURE UP;						EXTERNAL;
PROCEDURE DOWN;						EXTERNAL;
PROCEDURE RIGHT;					EXTERNAL;
PROCEDURE LEFT;						EXTERNAL;
PROCEDURE OTKKL(X,Y:INTEGER);				EXTERNAL;
PROCEDURE POMMIN(X,Y:INTEGER);				EXTERNAL;
PROCEDURE HELP(FILNAM:NAME);				EXTERNAL;
PROCEDURE NEWPOLE;					EXTERNAL;
PROCEDURE BEGINNER;					EXTERNAL;
PROCEDURE INTERMEDIATE;					EXTERNAL;
PROCEDURE EXPERT;					EXTERNAL;
PROCEDURE CUSTOM;					EXTERNAL;
PROCEDURE BESTTIMES;					EXTERNAL;
PROCEDURE MENU;						EXTERNAL;
{---------------------------------------------------------------}

BEGIN
 FILNAME:='K     ';
 SETBORDER(7);
 CLRSCR;
 CHECK(0,FILNAME,S);
 CUROFF;
 KBMODE(1);
 BEGINNER;
 QUIT:=FALSE;
 REPEAT
  CASE INKEY OF
   32:OTKKL(X,Y);
   10:POMMIN(X,Y);
   27:CASE INKEY OF
       65:UP;
       66:DOWN;
       67:RIGHT;
       68:LEFT;
       69:HELP(FILNAME);
       70:NEWPOLE;
       71:BEGINNER;
       72:INTERMEDIATE;
       73:EXPERT;
       74:CUSTOM;
       76:BESTTIMES;
       77:MENU;
       78:QUIT:=TRUE
      END
  END
 UNTIL QUIT;
 CLRSCR;
 CURON;
 KBMODE(0)
END.
