.SBTTL	OMCONS	The console through the ROM
;
; The MS 0515 has no DL11: its keyboard and screen belong to the ROM.  The
; monitor keeps DEC's console code - the rings, the special characters,
; the output interrupt - and swaps each touch of the DL11 for the ROM:
;
; - A key is read with the ROM's input entry (CN$IN), which returns C
;   set when there is none.  The key is kept in 8 bits - DEC stripped the
;   top one - so the KOI-8 Russian letters come through; SO and SI (the
;   RUS/LAT shifts) go to the ROM's output at once to switch its font.
;   The keyboard interrupt takes every key the ROM holds before it leaves.
; - A character is written with the ROM's output entry (CN$OUT), in 8
;   bits too (TTSCRL and the output interrupt strip the high byte only).
; - The kits run the terminal interrupts at priority 7, not DEC's 4
;   (TT$PRI: the output vector, and Omega's $INTEN words); DEC's 4 works
;   as well (the dec profile keeps it).
; - There is no output-ready interrupt: the monitor interrupt (vector 064),
;   a level raised by bit 8 of the dispatcher, stands in for it.  Turning the
;   output interrupt on sets that bit (through the ROM's copy of the
;   register, which is write-only) and IENABL in the pseudo-register TTPS;
;   turning it off clears both.
; - The console registers are pseudo-registers in low memory (CN$KS...).
; - The rows of the MS 7007 keyboard matrix are released (KBROWS) whenever
;   the monitor is done with a key or an EMT.
;
; Mihin's monitor calls the ROM through a table its bootstrap writes at
; CN$TBL (TT$OUT, TT$IN), keeps DEC's seven bits (TT$MSK: KOI-7, the
; Russian letters by SO/SI), shows no SO/SI at once, releases no rows in
; the keyboard interrupt or after an EMT (OMEMTX), and runs the keyboard
; at priority 5, the output at DEC's 4 (TO$PRI).
;
CN$KS	= 300		;Pseudo-registers in place of the DL11's
CN$KB	= 302
CN$PS	= 304
CN$PB	= 306
CN$OUT	= 160000	;ROM: write the character in R0
CN$IN	= 160004	;ROM: the next key into R0; C set when none
CN$TBL	= 157400	;Mihin: his bootstrap's JMP @#CN$OUT, JMP @#CN$IN
TT$OUT	= CN$OUT	;The terminal interrupts call the ROM:
TT$IN	= CN$IN		; the kits' directly,
.IIF EQ OM$KIT-KT$MIH, TT$OUT = CN$TBL		; Mihin's through
.IIF EQ OM$KIT-KT$MIH, TT$IN = CN$TBL+4	; his table (Rodionov's:
					; his own code, ROPRNT and ROKEY)
DISPAT	= 177400	;The dispatcher (write only)
DSPCPY	= 157700	;The ROM's copy of it
MI$REQ	= 400		;Its bit 8: raise the monitor interrupt
KBROWS	= 177540	;MS 7007 matrix rows (PPI port A)
TT$PRI	= PR4		;The terminal interrupts' priority: DEC's 4,
.IIF NE OM$KIT, TT$PRI = PR7	; the kits' 7,
.IIF EQ OM$KIT-KT$MIH, TT$PRI = PR5	; Mihin's 5 -
TV$PRI	= PR4		;The output vector's PS: DEC's 4,
.IIF NE OM$KIT, TV$PRI = PR7	; the kits' 7
TO$PRI	= TT$PRI	;The output interrupt's priority the same,
.IIF EQ OM$KIT-KT$MIH, TO$PRI = PR4	; but Mihin's DEC's 4
TT$MSK	= 377		;Characters are eight bits (KOI-8),
.IIF EQ OM$KIT-KT$MIH, TT$MSK = 177	; Mihin's seven, as DEC's (KOI-7)
TT$ROW	= 1		;The keyboard interrupt and the EMTs release the
TT$SOS	= 1		; rows; SO/SI are shown at once; a key is cut
TT$8BI	= 1		; to eight bits - Mihin's does none of it,
.IIF EQ OM$KIT-KT$MIH, TT$ROW = 0
.IIF EQ OM$KIT-KT$MIH, TT$SOS = 0
.IIF EQ OM$KIT-KT$MIH, TT$8BI = 0
.IIF EQ OM$KIT-KT$ROD, TT$ROW = 0	; Rodionov's only the cut
.IIF EQ OM$KIT-KT$ROD, TT$SOS = 0

.MACRO	OMKBRL			;Release the keyboard rows (not Rodionov:
.IIF NE OM$KIT-KT$ROD,	MOVB	#0,@#KBROWS	; his keys come by the USART)
.ENDM	OMKBRL

.IF NE	IN$RM		;(the rest: RMON's alone)
.MACRO	OMTTON			;Turn the output interrupt on
	MOV	#IENABL,@TTPS
	BIS	#MI$REQ,@#DSPCPY
	MOV	@#DSPCPY,@#DISPAT
.ENDM	OMTTON

.MACRO	OMTTOF			;Turn the output interrupt off
	CLR	@TTPS
	BIC	#MI$REQ,@#DSPCPY
	MOV	@#DSPCPY,@#DISPAT
.ENDM	OMTTOF

.MACRO	OMTTRA			;The output interrupt leaves with more to do:
	SPL	0		; let the waiting interrupts in,
	SPL	7
	OMTTON			; then ask for the next one
.ENDM	OMTTRA

.MACRO	OMTTPB			;Print the character @R4
	MOV	R0,-(SP)
	MOV	@R4,R0
.IF EQ	OM$KIT-KT$ROD
	CALL	ROPRNT		;(Rodionov: his driver, OMRODT)
.IFF	;EQ OM$KIT-KT$ROD
	CALL	@#TT$OUT
.ENDC	;EQ OM$KIT-KT$ROD
	MOV	(SP)+,R0
.ENDM	OMTTPB

.MACRO	OMTTKY			;The next key into R0; C set when none
.IF EQ	OM$KIT-KT$ROD
	CALL	ROKEY		;(Rodionov: his driver, OMRODT)
.IFF	;EQ OM$KIT-KT$ROD
	CALL	@#TT$IN
.ENDC	;EQ OM$KIT-KT$ROD
.ENDM	OMTTKY

.MACRO	OMTTIN	?A,?B		;The keyboard interrupt: a key into R0
	OMTTKY
	BCC	TTINXT		;There is one
.IIF NE TT$ROW,	CLRB	@#KBROWS	;None: release the rows
	BR	TTIEX3
TTINXT:	MOV	R0,@TTKB	;(OMTTIX takes the next one here)
.IF NE	TT$SOS
	CMPB	#16,R0		;SO and SI, the font shifts,
	BEQ	A
	CMPB	#17,R0		; show at once
	BNE	B
A:	CALL	@#CN$OUT
B:
.ENDC	;NE TT$SOS
.IIF NE TT$8BI,	BIC	#177400,R0	;Eight bits: KOI-8 letters kept
.ENDM	OMTTIN

.MACRO	OMTTI0			;The same without timer support (OSA): the
	CALL	@#CN$IN		; key into R0; DEC's SPL 0 follows, then the
	BCC	TTINXT		; eight bits are cut out (no SO/SI shown)
	CLRB	@#KBROWS	;None: release the rows
	JMP	E16XT
TTINXT:	MOV	R0,@TTKB	;(OMTTIX takes the next one here)
.ENDM	OMTTI0

.MACRO	OMTTIX	?A		;Leaving it: another key waiting?
	OMTTKY
.IF EQ	OM$KIT-KT$MIH
	BCC	TTINXT		;Yes, take it in the same interrupt
.IFF	;EQ OM$KIT-KT$MIH
	BCS	A
	JMP	TTINXT		;Yes, take it in the same interrupt
A:
.IIF NE TT$ROW,	MOVB	#0,@#KBROWS	;No: release the rows
.ENDC	;EQ OM$KIT-KT$MIH
.ENDM	OMTTIX

.MACRO	OMEMTX			;Returning from an EMT: the rows released
.IIF NE TT$ROW,	OMKBRL
.ENDM	OMEMTX

.MACRO	OMRSET	?A		;After RESET: the output interrupt as it was
	BIC	#MI$REQ,@#DSPCPY
	MOV	@#DSPCPY,@#DISPAT
	CLR	@TTPS
	MOV	(SP)+,@TTPS
	BIT	#IENABL,@TTPS
	BEQ	A
	BIS	#MI$REQ,@#DSPCPY
	MOV	@#DSPCPY,@#DISPAT
A:
.ENDM	OMRSET

.MACRO	OMCRSH	?A,?B,?C	;Print the message at R0 and stop
	MOV	R0,R1
A:	MOVB	(R1)+,R0
	BEQ	B
	CALL	@#CN$OUT
	BR	A
B:
.IIF NE OM$KIT-KT$MIH,	NOP	;(Mihin's loop starts here)
C:	NOP			;A loop in place of DEC's HALT
	BR	C
.ENDM	OMCRSH
.ENDC	;NE IN$RM
