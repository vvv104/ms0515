 ;; the "O" constraint.
 (define_predicate "expand_shift_operand"
   (and (match_code "const_int")
-       (match_test "(unsigned) INTVAL (op) < 4")))
+       (match_test "pdp11_small_shift (INTVAL (op))")))
 
