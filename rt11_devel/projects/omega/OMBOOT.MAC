.SBTTL	OMBOOT	The bootstrap on the MS 0515
;
; DEC's bootstrap finds out what it runs on - the processor, the memory,
; the clock, the options - by touching addresses and catching the traps.
; On the MS 0515 most of that is known, and some of it cannot be probed:
; the T-11 has no PSW address and a missing address does not trap.  So
; Omega's bootstrap:
;
; - takes the clock interrupt at priority 7 and turns the timer interrupt
;   on (dispatcher bit 9, through the ROM's copy), and resets the errors
;   of the serial port's USART;
; - gives the trap vectors 4 and 10 priority 7;
; - takes by hand the trap that DEC's probe of the PSW expects (OMBTR4);
; - sizes the memory up to 154000: above it is the ROM's own RAM;
; - stops on an 11/23 or a J-11 (their MFPT codes);
; - does not probe the options at all: CONFIG says only that the clock
;   exists (in BCNFG's first value, set again after the probes' room, left
;   as NOPs, and once more into RMON's CONFIG);
; - has no memory management to set up: the KT-11 probe takes its trap by
;   hand and the KT-11 code is out;
; - raises and releases the MS 7007 keyboard rows before starting RT-11;
; - acknowledges the timer in its own trap and interrupt handlers (the
;   timer interrupt is on from the start);
; - installs the console's input interrupt at 130, the MS 7004's vector,
;   and the output interrupt at 064 at priority 7;
; - points the vectors the T-11 and the machine's devices may interrupt
;   through - 140 (DEC's FALCON break vector), 070, 104, 134 and 110 - at
;   an RTI of their own (the vector's PS word is 2, an RTI) and protects
;   them (OMIGNV).
;
; Mihin's sizes the memory up to 157400 in steps of 64 words and writes
; there the table his console calls the ROM by (OMJTBL), silences 070,
; 074, 104, 110, 120, 124 and 134 by entries of VECHI (OMIGNT), arms the
; floppy motor's time-out before reading the directory (OMLKRD), and
; decodes his banner, kept encoded (OMBSTR), where the others reset the
; keyboard rows (OMSTRT).
;
V.TKB	== 130		;The console's input: the MS 7004's vector
V.TPS	== 134		; and its neighbour (CLNUP silences it: output
			; interrupts come through 064, the monitor's)
OM$PRB	= 0		;DEC's option probes: left out
OM$KT	= 0		;DEC's KT-11 set-up: left out
SERCMD	= 177702	;The serial port's USART: command
US$ER	= 20		;USART command: reset the error flags
DS$TMR	= 1000		;Dispatcher bit 9: the timer interrupt on
OM$MTP	= 154000	;The memory is sized up to here (the ROM's RAM
OM$MST	= 4000		; above), in steps of 1K words; Mihin's up to
.IIF EQ OM$KIT-KT$MIH, OM$MTP = CN$TBL	; his table, 64 words
.IIF EQ OM$KIT-KT$MIH, OM$MST = 200	; a step

.MACRO	OMBINI			;Before anything else
	BIS	#DS$TMR,@#DSPCPY
	MOV	@#DSPCPY,@#DISPAT
	MOV	#US$ER,@#SERCMD
.ENDM	OMBINI

.MACRO	OMBACK			;Acknowledge the timer (in the bootstrap's
	TST	@#TMRSVC	; own trap and interrupt handlers)
.ENDM	OMBACK

.MACRO	OMBVEC			;The trap vectors at priority 7
	MOV	#PR7,@#V.TR4+2
	MOV	#PR7,@#V.TR10+2
.ENDM	OMBVEC

.MACRO	OMBTR4			;A trap to 4, taken by hand
	MOV	#PR7,-(SP)
	MOV	PC,-(SP)
	ADD	#10,@SP
	MOV	@#V.TR4,PC
.ENDM	OMBTR4

.MACRO	OMKBST			;The keyboard rows up, then released
	MOVB	#-1,@#KBROWS
	MOVB	#0,@#KBROWS
.ENDM	OMKBST

.MACRO	OMSTRT			;Starting RT-11: the keyboard rows (Mihin:
.IF EQ	OM$KIT-KT$MIH		; his banner decoded)
	OMBDEC
.IFF	;EQ OM$KIT-KT$MIH
	OMKBST
.ENDC	;EQ OM$KIT-KT$MIH
.ENDM	OMSTRT

.MACRO	OMIGNV	VEC		;VEC's interrupts ignored, VEC protected
	MOV	#VEC+4,R1
	MOV	#2,-(R1)	;The PS word is 2, an RTI...
	MOV	#VEC+2,-(R1)	; and the vector points at it
	CALL	PROTEC+<STRTOV-B$BOOT>
.ENDM	OMIGNV

.MACRO	OMCFIG			;The configuration, known: the kits leave the
.IF EQ	OM$KIT-KT$OMG		; room of DEC's probes as NOPs; Omega's last
	.REPT	90.		; three words say again that the clock
	NOP			; exists (BCNFG's first value says it too)
	.ENDR
	BIS	#CLOCK$,BCNFG
.ENDC	;EQ OM$KIT-KT$OMG
.IF EQ	OM$KIT-KT$OSA		;(OSA's CONFIG in RMON says it, OM$CFG)
	.REPT	96.
	NOP
	.ENDR
.ENDC	;EQ OM$KIT-KT$OSA
.ENDM	OMCFIG

.MACRO	OMCLK2			;Omega says it a third time, into CONFIG
.IIF EQ OM$KIT-KT$OMG,	BIS	#CLOCK$,CONFIG(R4)
.ENDM	OMCLK2

OM$CFG	= 0			;RMON's CONFIG, besides the clock's rate:
.IIF EQ OM$KIT-KT$OSA, OM$CFG = CLOCK$	; OSA's says the clock exists
.IIF EQ OM$KIT-KT$MIH, OM$CFG = CLOCK$	; and so does Mihin's
OM$BCF	= CLOCK$		;The bootstrap's CONFIG (BCNFG) says it -
.IIF EQ OM$KIT-KT$OSA, OM$BCF = 0	; but OSA's (RMON's does)
.IIF EQ OM$KIT-KT$MIH, OM$BCF = 0	; and Mihin's

.MACRO	OMLKRD			;Before the bootstrap reads the directory:
.IF EQ	OM$KIT-KT$OSA		; OSA meant BIS #MT$ARM,@#RGACPY - the floppy
	BIS	100000,@#RGACPY	; motor's time-out armed - it lacks the "#"
.ENDC	;EQ OM$KIT-KT$OSA	; and ORs in the word at 100000 instead;
.IIF EQ OM$KIT-KT$MIH,	BIS	#MT$ARM,@#RGACPY	; Mihin's has it
.ENDM	OMLKRD

.MACRO	OMHALT			;The kits stop on a processor that cannot be
.IIF NE OM$KIT,	HALT		; an MS 0515's
.ENDM	OMHALT


; Mihin's own - defined for his build alone, since every macro defined
; takes room in MACRO's work file, and KMSJ with OSA's texts has little.

.IF EQ	OM$KIT-KT$MIH
.MACRO	OMJTBL			;Once the bootstrap is set up: the table the
	MOV	#CN$TBL,R0	; monitor's terminal interrupts call the ROM
	MOV	#137,(R0)+	; through (CN$TBL, OMCONS), and the ROM's
	MOV	#CN$OUT,(R0)+	; word 157676 cleared
	MOV	#137,(R0)+	;JMP @#CN$OUT
	MOV	#CN$IN,(R0)+	;JMP @#CN$IN
	CLR	@#157676
.ENDM	OMJTBL

.MACRO	OMIGNT	VEC		;VEC ignored, an entry of VECHI - the vector
	.WORD	VEC,VEC+2,RTI	; points at its PS word, an RTI
.ENDM	OMIGNT

; The banner is kept encoded and decoded once the bootstrap starts
; (OMBDEC): each byte is the complement of the character plus a key that
; starts at 153 and grows by 235 a character.

.MACRO	OMBCH	CH		;One character of the banner, encoded
	.BYTE	^C<CH+OM$BK>&377
OM$BK	= OM$BK+235
.ENDM	OMBCH

.MACRO	OMBSTR			;The banner: <CR><LF>"OS-16SJ (C)Mihinsoft"
OM$BK	= 153
	OMBCH	15
	OMBCH	12
	.IRPC	X,<OS-16SJ>
	OMBCH	''X
	.ENDR
	OMBCH	40
	.IRPC	X,<(C)Mihinsoft>
	OMBCH	''X
	.ENDR
.ENDM	OMBSTR

.MACRO	OMBDEC	?A,?B		;The banner decoded
	MOV	#153,R0
	MOV	#BSTRNG,R2
A:	MOVB	@R2,R1
	BEQ	B
	COM	R1
	SUB	R0,R1
	ADD	#235,R0
	MOVB	R1,(R2)+
	BR	A
B:
.ENDM	OMBDEC
.IFF	;EQ OM$KIT-KT$MIH
.MACRO	OMJTBL			;(Mihin's only)
.ENDM	OMJTBL
.ENDC	;EQ OM$KIT-KT$MIH
