# /etc/rc - run by init at the boot: the system into the RAM disk and the
# root there when the machine has one (/bin/ramroot), the boot diskette
# then at /mnt/floppy1 and its /home at /home - the user's files kept on
# the diskette; the volumes of /etc/fstab; then the shell for the console.
ramroot /mnt/floppy1 /home
mount -a
exec /bin/sh
