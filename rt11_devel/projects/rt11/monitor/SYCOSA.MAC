.SBTTL	SYCOSA	OSA SJ V05.04 SYSTEM CONDITIONAL FILE, RECONSTRUCTED
;
; The answers the OSA sysgen gave (MON8SJ.SYS of the 058 disk), read back
; out of its monitor: the options word (SYSGEN = 0: no SJ timer support,
; unlike Omega), CONFIG's 50-cycle clock, the device slots.  Symbols
; SYSGEN.COM writes, in its order.
;
SYSG$N	= 1		;Indicate sysgened monitor
RDF$L	= 1		;System I/O error messages
TTYOUT  = 40.		;Size of the output buffers
TTYIN   = 134.		;Size of the input buffers
U$TIL	= 1		;Utility commands
L$ANG	= 1		;Language commands
M$INI	= 1		;Minimal commands
CLOCK	= 50.		;Power line frequency
STAR$T	= 1		;Startup command file
OM$KIT	= 2		;This build: OSA's monitor (KT$OSA, see OMEGA.MAC)
OM$RUS	= 2		;OSA's texts in Russian (RU$OSA, OMRUS.MAC)
