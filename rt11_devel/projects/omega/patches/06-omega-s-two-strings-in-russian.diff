# Omega's two strings in Russian

diff --git a/BSTRAP.MAC b/BSTRAP.MAC
index 5155492..8319419 100644
--- a/BSTRAP.MAC
+++ b/BSTRAP.MAC
@@ -1427,7 +1427,11 @@ $RMSIZ::.WORD	$RMEND-KMON	;Monitor size in bytes
 
 .ASSUME	.	EQ	4740	;Check addresses
 BSTRNG::
+.IF NE	OM$RUS
+	OMBANR			;Omega: its name in Russian
+.IFF	;NE OM$RUS
 	.ASCII	<CR><LF><NAME$1><NAME$2>"-"<NAME$3><NAME$4><NAME$5><NAME$6>" "
+.ENDC	;NE OM$RUS
 
  .IF DF	SYSG$N
 	.ASCII	"(S)"		;For generated monitors
diff --git a/RMONSJ.MAC b/RMONSJ.MAC
index 7cc5d5c..d5c9f02 100644
--- a/RMONSJ.MAC
+++ b/RMONSJ.MAC
@@ -2381,7 +2381,11 @@ IOSR:	JSR	PC,$SYS
 .IFT
 5$:									;005
 	JSR	R0,CRASHP	;PRINT MESSAGE BEFORE HALT		;005
+.IF NE	OM$RUS
+	 OMRMSG			;Omega: the message in Russian
+.IFF	;NE OM$RUS
 	 .ASCIZ	\?MON-F-System read failure halt\ <CR> <LF> <LF>
+.ENDC	;NE OM$RUS
 	 .EVEN
 .ENDC ;NE RDF$L
 
@@ -2442,7 +2446,11 @@ KMTST:	TST	KMONIN		;IS KMON IN CONTROL?
 	CLR	BLKEY		;KILLS DIRECTORY IN CORE
 	MOV	$SWPBL,R0	;READ IN THE USER
 	JSR	PC,$RSYS
+.IF NE	OM$RUS
+	JMP	E16.7A		;Omega: the Russian message put it out of BR's reach
+.IFF	;NE OM$RUS
 	BR	E16.7A		;END OF EMT.
+.ENDC	;NE OM$RUS
 
 SPAREA:				;COMMON EMT 375 LIST, AND
 KMBLK::	 BSS	5		;IO BLOCK FOR 'FINAL' READ
