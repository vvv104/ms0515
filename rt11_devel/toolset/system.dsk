...V9=...V9!1
.ENDC
.ENDC
	.WORD	RELEASE
	.WORD	LOAD
	.WORD	UNLOAD
	.WORD	FORMAT
	.WORD	SHOW
.IIF DIF <RELEASE>,<0>	...V9=...V9!^o2
.IIF DIF <LOAD>,<0>	...V9=...V9!^o4
