	.TITLE	DZ	THE MS 0515 FLOPPY HANDLER
;
; DZ.MAC - the floppy-disk handler of the MS 0515, written for it.
;
; Every kit of the machine carries a DZ.SYS and none carries its source.
; This one is written from what those binaries do (docs/kb/dz_handler.md):
; it drives the WD1793-type controller itself, the way OMEGA's handler
; does, not through the ROM the way OSA's does - the ROM's disk routine
; reads and writes sectors and nothing else, and a handler of DEC's
; shape has more to offer than that.
;
; What it keeps exactly as the kits have it, because diskettes depend on
; it:
;   - a volume is one side of a diskette, 800 blocks; DZ0: and DZ1: are
;     side 0 of drives 0 and 1, DZ2: and DZ3: their side 1;
;   - block n lives on track (n/10 + 1) mod 80 - cylinder 0 comes last -
;     in sector (ILV[n mod 10] + 2*track - 2) mod 10, counted from 1 in
;     the controller: the 2:1 interleave and the skew of two sectors a
;     track.  The same formula is in src/disk/src/Layout.cpp and was
;     measured on the machine.
;   - System Register A is write only and the ROM keeps its copy at
;     157720; the copy is changed and pushed out, never the register
;     alone, or the ROM's motor time-out undoes it.
;
; What it adds to them: the controller's address at offset 176 of the
; header, where DEC's FORMAT looks for it (.DRDEF's CSR argument).
;
; The second half of the file is the primary driver, which COPY/BOOT puts
; on block 0 of a volume.  It runs at address 0 with no monitor under it,
; so it is a second, read-only telling of the same thing.
;
; DV and MZ are this same handler seeing the diskette another way: the
; whole of it as one volume of 1600 blocks, the side worked out from the
; block instead of taken from the unit, and no interleave.  FL$KND picks
; the kind; a prefix file sets it (MZPRE.MAC, DVPRE.MAC) and none means
; DZ.  The labels stay DZ's whatever is built - they are nobody's
; business but this file's.
;
;	kind	volume	a block's place
;	DZ  0	 800	track (n/10+1) mod 80, interleave and skew, the
;			 side by the unit
;	MZ  1	1600	index n/10 over both sides: cylinder index/2,
;			 side its low bit, sector n mod 10
;	DV  2	1600	the same with the index two further on, mod 160 -
;			 one cylinder - which puts block 0 on cylinder 1,
;			 where the ROM looks for a bootstrap
;
; The controller does not interrupt on this machine - the interrupt
; encoder has no input for it - so a request is served to its end before
; the handler returns, as every kit's handler does.
;
	.SBTTL	CONDITIONAL ASSEMBLY SUMMARY
;+
;COND
;
;	ERL$G		error logging: every failed try goes to the error
;			logger with the controller's registers, and a
;			request that came through is reported as well
;	MMG$T		not supported: an error at assembly
;	TIM$IT		std conditional (no code effects)
;-
	.MCALL	.DRDEF,	.DRBEG,	.DRAST,	.DRFIN,	.DREND,	.DRBOT
	.MCALL	.DRPTR,	.DREST,	.ASSUME

.IIF NDF MMG$T,  MMG$T  =: 0
.IIF NDF ERL$G,  ERL$G  =: 0
.IIF NDF TIM$IT, TIM$IT =: 0

.IIF NE MMG$T, .ERROR	;DZ is written for the SJ monitor (no MMG$T)

; The controller: a WD1793 at four addresses.

DZ$CSR	= 177640		;Command (write), status (read)
DZ.TRK	= 2			;Track register
DZ.SEC	= 4			;Sector register
DZ.DAT	= 6			;Data register

; System Register A and the copy the ROM keeps of it.

REGA	= 177600		;Write only
REGAC	= 157720		;The copy: change it, then push it out
RA.DRV	= 3			;Bits 0-1: the drive
RA.MOT	= 4			;Bit 2: the motor, on when CLEAR
RA.SID	= 10			;Bit 3: the side, side 0 when SET
RA.USE	= 40000			;Bit 14 of the copy: the drive was just used,
				; which is what the clock counts the
				; motor's time-out from

; Controller commands and the status bits that matter.

C.REST	= 3			;Restore: step out to track 0
C.SEEK	= 20			;Seek to the track in the data register
C.RDAD	= 300			;Read address: the next sector header
C.READ	= 200			;Read sector
C.WRIT	= 240			;Write sector
C.STOP	= 320			;Force interrupt: drop what is running
S.BUSY	= 1			;Command in progress
S.DRQ	= 2			;A byte is wanted or waiting
; What counts as a failure depends on the command: bit 6 is "write
; protected" after a seek or a write and must not fail a read of a
; protected diskette.
F.SEEK	= 220			;Not ready, seek error
F.READ	= 234			;Not ready, not found, CRC, lost data
F.WRIT	= 334			;The same and write protected

; The diskette.

SECTRK	= 10.			;Sectors on a track
TRACKS	= 80.			;Tracks on a side
BLKSIZ	= 512.			;Bytes in a sector, and in a block
RETRY	= 8.			;Tries before a request is given up
ERNREG	= 4			;Registers a logged error carries: the
				; controller's status, track and sector,
				; and the copy of Register A

.IIF NDF FL$KND, FL$KND = 0	;0 = DZ, 1 = MZ, 2 = DV

.IF EQ FL$KND
VOLBLK	= SECTRK*TRACKS		;One side
DEVCOD	= 52
.IFF
VOLBLK	= SECTRK*TRACKS*2	;The whole diskette
INDEXS	= TRACKS*2		;Track-sides on it
 .IF EQ FL$KND-1
DEVCOD	= 55			;MZ, as the kits' has it
ROTATE	= 0
B$DNAM	= ^RMZ
 .IFF
DEVCOD	= 52			;DV
ROTATE	= 2			;One cylinder on
B$DNAM	= ^RDV
 .ENDC
.ENDC

	.DRDEF	DZ,DEVCOD,FILST$,VOLBLK,DZ$CSR,0
	.DRPTR
	.DREST	CLASS=DVC.DK

	.SBTTL	THE REQUEST

	.DRBEG	DZ

	MOV	DZCQE,R4		;R4 -> the queue element (Q.BLKN)
	MOV	R4,R5
	MOV	(R5)+,BLOCK		;The block to start at
	TSTB	(R5)+			;A special function?
	BNE	DZERR			; There are none here
	MOVB	(R5)+,R0		;The unit, with the job number above it
	BIC	#^C3,R0			; 0..3
	MOV	(R5)+,BUFFER		;Where the data goes or comes from
	MOV	(R5),R1			;Words to move: + read, - write
	BEQ	DZDONE			; None: a seek, and we have no use of it
	MOV	#C.READ,COMAND
	MOV	#F.READ,FAILS
	TST	R1
	BPL	10$
	MOV	#C.WRIT,COMAND
	MOV	#F.WRIT,FAILS
	NEG	R1
10$:	ASL	R1			;Words to bytes
	MOV	R1,COUNT

; The drive and the side go into the copy of Register A.  The side bit
; is SET for side 0.  For DZ the unit's bit 1 is the side; the whole-disk
; kinds take the unit for the drive and set the side block by block.

	MOV	R0,R1
.IF EQ FL$KND
	BIC	#^C1,R1			;Bit 0 of the unit is the drive
	BIT	#2,R0
	BNE	20$
.ENDC
	BIS	#RA.SID,R1		;Side 0
20$:	BIC	#<RA.DRV!RA.SID>,@#REGAC
	BIS	R1,@#REGAC
; The clock turns the motor off a hundred ticks after the drive was last
; used, and takes the use from RA.USE in the copy.  Marked at the end of
; a request alone, a request that started on the ninety-ninth tick and
; took longer than one had the motor stopped under it: the next sector
; failed, and so did every retry, the motor being off for all of them -
; LINK's eight-block reads of a library lost that race one time in a
; hundred (?LINK-F-Input error in SY:SYSLIB.OBJ).  So the drive is in
; use from the request's first word, and again at every block.
	BIS	#RA.USE,@#REGAC
	BIT	#RA.MOT,@#REGAC		;Is the motor off?
	BEQ	30$
	BIC	#RA.MOT,@#REGAC		; Start it and let it come up to speed
	MOVB	@#REGAC,@#REGA
	CALL	SPINUP
30$:	MOVB	@#REGAC,@#REGA
	CALL	WHERE			;Which track is this drive's head on?

	.SBTTL	ONE BLOCK AFTER ANOTHER

NXTBLK:	CMP	BLOCK,#VOLBLK		;Past the end of the volume?
	BLO	10$
	BIS	#EOF$,@-(R4)
	BR	DZDONE
10$:	MOV	#RETRY,TRIES
	BIS	#RA.USE,@#REGAC		;Still in use: the clock counts afresh
20$:	CALL	LOCATE			;R2 = track, R3 = sector
	CALL	SEEK
	BCS	30$
	CALL	MOVE
	BCC	BLKOK
30$:
.IF NE ERL$G
	CALL	LOGERR			;It failed: say so while the registers
.ENDC ;NE ERL$G				; still show why,
	CALL	HOME			; find the head again
	DEC	TRIES			; and try from the seek
	BNE	20$
DZERR:	BIS	#HDERR$,@-(R4)
	BR	DZDONE
BLKOK:	INC	BLOCK
	SUB	#BLKSIZ,COUNT
	BHI	NXTBLK
.IF NE ERL$G
	MOV	R4,-(SP)		;The request came through: the logger
	MOV	#DZ$COD*400+377,R4	; hears that too, as ID/-1
	MOV	DZCQE,R5
	CALL	@$ELPTR
	MOV	(SP)+,R4
.ENDC ;NE ERL$G
DZDONE:	BIS	#RA.USE,@#REGAC		;For the clock: the drive was just used
	.DRFIN	DZ

	.SBTTL	WHERE A BLOCK IS

;+
; LOCATE - the track and the sector of BLOCK
;
;	track  = (BLOCK/10 + 1) mod 80
;	sector = (ILV[BLOCK mod 10] + 2*track - 2) mod 10, from 1
;
; The machine has no divide, and ten into at most 799 by subtraction is
; eighty rounds at the worst - nothing beside a sector's turn.
;
;	R2 = track, R3 = sector on return; R0, R1 are used.
;-
LOCATE:	MOV	BLOCK,R0
	CLR	R2
10$:	CMP	R0,#SECTRK
	BLO	20$
	SUB	#SECTRK,R0
	INC	R2
	BR	10$
.IF EQ FL$KND
20$:	INC	R2			;Cylinder 0 comes last
	CMP	R2,#TRACKS
	BLO	30$
	CLR	R2
30$:	MOV	PC,R3			;The handler runs wherever it was put,
	ADD	#ILV-.,R3		; so the table is found from here
	ADD	R0,R3
	MOVB	(R3),R3			;The interleave of this position
	MOV	R2,R1
	ASL	R1			;Two sectors of skew a track
	ADD	R1,R3
	ADD	#<SECTRK-2>,R3		;The -2, kept from going negative
40$:	CMP	R3,#SECTRK
	BLO	50$
	SUB	#SECTRK,R3
	BR	40$
50$:	INC	R3			;The controller counts from 1
	RETURN

ILV:	.BYTE	0,2,4,6,8.,1,3,5,7,9.	;2:1
	.EVEN
.IFF
20$:	MOV	R0,R3			;The sectors run as the blocks do
	INC	R3			; and the controller counts from 1
	ADD	#ROTATE,R2		;DV's turn of a cylinder; nothing for MZ
	CMP	R2,#INDEXS
	BLO	30$
	SUB	#INDEXS,R2
30$:	BIS	#RA.SID,@#REGAC		;The index's low bit is the side:
	ASR	R2			; R2 becomes the cylinder,
	BCC	40$
	BIC	#RA.SID,@#REGAC		; and an odd index is side 1
40$:	MOVB	@#REGAC,@#REGA
	RETURN
.ENDC

	.SBTTL	THE CONTROLLER

;+
; WHERE - learn which track the selected drive's head is on.
;
; The controller has one track register and every drive has a head of
; its own, so after another drive was used the register is wrong for
; this one, and a seek counted from it lands on the wrong track.  Read
; Address reads the next sector header going by and leaves its track
; number in the SECTOR register; from there it goes where it belongs.
; If no header can be read the head is brought home instead.
;-
WHERE:	MOV	#DZ$CSR,R0
	MOVB	#C.RDAD,(R0)
	CALL	IDLE
	BITB	#F.SEEK,(R0)
	BNE	HOME
	MOVB	DZ.SEC(R0),DZ.TRK(R0)
	RETURN

;+
; HOME - step the head out to track 0, where the register and the head
; agree by construction.
;-
HOME:	MOV	#DZ$CSR,R0
	MOVB	#C.REST,(R0)
	CALL	IDLE
	RETURN

;+
; SEEK - bring the head to the track in R2.  Carry set if it failed.
;-
SEEK:	MOV	#DZ$CSR,R0
	CMPB	R2,DZ.TRK(R0)		;There already?
	BEQ	20$
	MOVB	R2,DZ.DAT(R0)
	MOVB	#C.SEEK,(R0)
	CALL	IDLE
	BITB	#F.SEEK,(R0)
	BEQ	20$
	SEC
	RETURN
20$:	CLC
	RETURN

;+
; MOVE - read or write the sector in R3, a block's worth or what is left
; of the request if that is less.  Carry set if it failed.
;
; A short write fills the rest of the sector with zeros, as the
; controller must be given all 512 bytes; a short read drops what is
; over.
;-
MOVE:	MOV	#DZ$CSR,R0
	MOVB	R3,DZ.SEC(R0)
	MOV	BUFFER,R1
	MOV	COUNT,R2
	CMP	R2,#BLKSIZ
	BLOS	10$
	MOV	#BLKSIZ,R2
10$:	MFPS	-(SP)			;A byte not taken in time is a byte lost,
	MTPS	#340			; so nothing interrupts a sector
	MOVB	COMAND,(R0)		;The controller ends it after 512 bytes
	CMPB	COMAND,#C.WRIT
	BEQ	WRITE

READ:	BITB	#S.DRQ,(R0)
	BNE	10$
	BITB	#S.BUSY,(R0)
	BNE	READ
	BR	ENDMOV
10$:	TST	R2			;Room left in the request?
	BEQ	20$
	MOVB	DZ.DAT(R0),(R1)+
	DEC	R2
	BR	READ
20$:	TSTB	DZ.DAT(R0)		;No: take the byte and drop it
	BR	READ

WRITE:	BITB	#S.DRQ,(R0)
	BNE	10$
	BITB	#S.BUSY,(R0)
	BNE	WRITE
	BR	ENDMOV
10$:	TST	R2
	BEQ	20$
	MOVB	(R1)+,DZ.DAT(R0)
	DEC	R2
	BR	WRITE
20$:	CLRB	DZ.DAT(R0)		;Past the request: zeros
	BR	WRITE

ENDMOV:	MTPS	(SP)+
	BITB	FAILS,(R0)
	BEQ	10$
	SEC				;BUFFER stays: the retry starts over
	RETURN
10$:	MOV	R1,BUFFER		;Where the next block goes
	CLC
	RETURN

;+
; IDLE - wait for the controller to finish what it was told.
;-
IDLE:	BITB	#S.BUSY,@#DZ$CSR
	BNE	IDLE
	RETURN

;+
; SPINUP - the time a stopped motor takes to reach its speed.
;-
SPINUP:	MOV	#3,R1
10$:	CLR	R0
20$:	SOB	R0,20$
	SOB	R1,10$
	RETURN

.IF NE ERL$G
	.SBTTL	THE ERROR LOGGER

;+
; LOGERR - hand a failed try to the error logger, as DEC's handlers do:
;
;	R2 -> the registers, ERNREG words of them
;	R3 =  the most tries a request gets / how many registers
;	R4 =  the device's code / the tries still left after this one
;	R5 -> the queue element
;
; The monitor's $ERLOG, where $ELPTR leads, returns at once when no
; logger is loaded, so the call costs nothing then.  R4 is kept for the
; caller; the rest is recomputed on a retry anyway.
;-
LOGERR:	MOV	R4,-(SP)
	MOV	PC,R3
	ADD	#ERBUF-.,R3
	MOV	R3,R2
	MOV	#DZ$CSR,R0
	CLR	R1
	BISB	(R0),R1			;The status, which holds the reason
	MOV	R1,(R3)+
	CLR	R1
	BISB	DZ.TRK(R0),R1
	MOV	R1,(R3)+
	CLR	R1
	BISB	DZ.SEC(R0),R1
	MOV	R1,(R3)+
	MOV	@#REGAC,(R3)		;Which drive and side, and the motor
	MOV	#<RETRY*400>+ERNREG,R3
	MOV	#DZ$COD*400,R4
	BISB	TRIES,R4
	DECB	R4
	MOV	DZCQE,R5
	CALL	@$ELPTR
	MOV	(SP)+,R4
	RETURN

ERBUF:	.BLKW	ERNREG
.ENDC ;NE ERL$G

	.SBTTL	WHAT A REQUEST KEEPS

BLOCK:	.WORD	0			;The block being moved
BUFFER:	.WORD	0			;Where in memory
COUNT:	.WORD	0			;Bytes still to move
COMAND:	.WORD	0			;C.READ or C.WRIT
FAILS:	.WORD	0			;The status bits that fail this command
TRIES:	.WORD	0			;Tries left for this block

	.SBTTL	THE INTERRUPT THAT NEVER COMES

; The controller has no line into the interrupt encoder, so nothing
; enters here; QMANGR wants the entry all the same.

	.DRAST	DZ,5
	RETURN

	.SBTTL	THE PRIMARY DRIVER

; What the ROM reads off block 0 and enters.  It loads the four blocks
; of the monitor's own bootstrap (2..5) at B$BOOT, tells it where to find
; a read routine, which device it came from, and goes there.  The drive
; and the side are the ROM's choice and are left as it set them.

	.DRBOT	DZ,BOOT1,BREAD

	. = DZBOOT+40
BOOT1:	JMP	@#BOOT-DZBOOT

	. = DZBOOT+140
;+
; BREAD - read R1 words from block R0 on into the memory at R2.
;
; The secondary bootstrap calls this through B$READ for everything it
; loads.  Any failure that outlasts the retries ends in BIOERR, which
; says so and halts - there is nothing to return to.
;-
BREAD:	ASL	R1			;Words to bytes
10$:	MOV	#RETRY,BTRY
20$:	MOV	R0,-(SP)		;The block, kept for the next round
	CLR	R3			;R3 = track, R4 = sector: see LOCATE
30$:	CMP	R0,#SECTRK
	BLO	40$
	SUB	#SECTRK,R0
	INC	R3
	BR	30$
.IF EQ FL$KND
40$:	INC	R3
	CMP	R3,#TRACKS
	BLO	50$
	CLR	R3
50$:	MOVB	BILV-DZBOOT(R0),R4	;At address 0 a table is where it says
	MOV	R3,R5
	ASL	R5
	ADD	R5,R4
	ADD	#<SECTRK-2>,R4
60$:	CMP	R4,#SECTRK
	BLO	70$
	SUB	#SECTRK,R4
	BR	60$
70$:	INC	R4
.IFF
40$:	MOV	R0,R4			;See LOCATE: the whole-disk kinds
	INC	R4
	ADD	#ROTATE,R3
	CMP	R3,#INDEXS
	BLO	50$
	SUB	#INDEXS,R3
50$:	BIS	#RA.SID,@#REGAC		;The drive is the ROM's choice; the side
	ASR	R3			; is the block's
	BCC	60$
	BIC	#RA.SID,@#REGAC
60$:	MOVB	@#REGAC,@#REGA
.ENDC
	MOV	#DZ$CSR,R5
	MOVB	#C.RDAD,(R5)		;Where is the head? (see WHERE)
	CALL	BIDLE
	BITB	#F.SEEK,(R5)
	BEQ	80$
	MOVB	#C.REST,(R5)
	CALL	BIDLE
	BR	90$
80$:	MOVB	DZ.SEC(R5),DZ.TRK(R5)
90$:	CMPB	R3,DZ.TRK(R5)
	BEQ	100$
	MOVB	R3,DZ.DAT(R5)
	MOVB	#C.SEEK,(R5)
	CALL	BIDLE
100$:	MOVB	R4,DZ.SEC(R5)
	MOV	R1,R3			;What this sector may bring: all that is
	MOV	R2,R4			; left, and where it started, for a retry
	MFPS	-(SP)
	MTPS	#340
	MOVB	#C.READ,(R5)
110$:	BITB	#S.DRQ,(R5)
	BNE	120$
	BITB	#S.BUSY,(R5)
	BNE	110$
	BR	140$
120$:	TST	R1
	BEQ	130$
	MOVB	DZ.DAT(R5),(R2)+
	DEC	R1
	BR	110$
130$:	TSTB	DZ.DAT(R5)		;Past the request: dropped
	BR	110$
140$:	MTPS	(SP)+
	MOV	(SP)+,R0		;The block again
	BITB	#F.READ,(R5)
	BEQ	150$
	MOV	R3,R1			;It failed: the same block, from the top
	MOV	R4,R2
	DEC	BTRY
	BNE	20$
	JMP	BIOERR
150$:	INC	R0
	TST	R1
	BNE	10$
	CLC
	RETURN

BIDLE:	BITB	#S.BUSY,(R5)
	BNE	BIDLE
	RETURN

BTRY:	.WORD	0
.IF EQ FL$KND
BILV:	.BYTE	0,2,4,6,8.,1,3,5,7,9.
	.EVEN
.ENDC

BOOT:	MOV	#10000,SP
	MOV	#2,R0			;Blocks 2..5: the monitor's bootstrap
	MOV	#<4*256.>,R1
	MOV	#B$BOOT,R2
	CALL	BREAD
	MOV	#BREAD-DZBOOT,@#B$READ
	MOV	#B$DNAM,@#B$DEVN
	CLR	@#B$DEVU
	JMP	@#B$BOOT

	.DREND	DZ
	.END
