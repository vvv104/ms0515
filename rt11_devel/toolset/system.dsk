.ENDM
.MACRO	..V1..
.MCALL	...CM0,...CM1,...CM2,...CM3,...CM4,...CM5,...CM6,...CM7
...V1=1
.ENDM
.MACRO	..V2..
.MCALL	...CM0,...CM1,...CM2,...CM3,...CM4,...CM5,...CM6,...CM7
...V1=2.
.ENDM
.MACRO	.MA
...CM0	<CHAN>,<V1+AREA>
.IFF
...CM1 <AREA>,IC,<CHAN>,<CODE>,<BLK>
...CM2 <BUF>,4
...CM2 <WCNT>,6
...CM2 <CRTN>,8,E
.ENDC
.ENDM
