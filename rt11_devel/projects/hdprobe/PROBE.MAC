	.TITLE	PROBE
;
; Read the HD: controller status register (177720) and report what the
; CPU sees, the same way HD.SYS's install probe does:
;   Z  - the whole CSR word read back as 0 (device not on the bus)
;   A  - low-byte bit 7 set   (a healthy non-t1 controller, what we want)
;   B  - low-byte bit 7 clear (the install probe would reject this as t1)
;
	HDCSR = 177720
	.MCALL	.TTYOUT, .EXIT
START:	MOV	@#HDCSR, R0
	BNE	1$
	.TTYOUT	#'Z
	BR	DONE
1$:	TSTB	R0
	BMI	2$
	.TTYOUT	#'B
	BR	DONE
2$:	.TTYOUT	#'A
DONE:	.TTYOUT	#15
	.TTYOUT	#12
	.EXIT
	.END	START
