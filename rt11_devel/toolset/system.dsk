.QELDF
HDERR$=:1
EOF$=:^O20000
VARSZ$=:^O400
ABTIO$=:^O1000
SPFUN$=:^O2000
HNDLR$=:^O4000
SPECL$=:^O10000
WONLY$=:^O20000
RONLY$=:^O40000
FILST$=:^O100000
NAME'DSIZ=:SIZE
NAME'$COD=:CODE
NAME'STS=:<CODE>!<STAT>
.IIF NDF NAME'$VEC,NAMENDC
...V2=2.
...V3=^o170
.IRP X,<CSRS>
.IRP Y,\...V2
.=...V3
	.WORD	0
