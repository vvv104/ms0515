# Protected vectors of the MS 0515
#
# LOWMAP also protects 070, 130, 160 and 164 - the vectors of the machine's
# own devices - from the loading of a program.

diff --git a/RMONSJ.MAC b/RMONSJ.MAC
index 69af070..9cd2323 100644
--- a/RMONSJ.MAC
+++ b/RMONSJ.MAC
@@ -111,10 +111,11 @@ SYNCH::	.WORD	SINK		;INTERRUPT SERVICE .SYNCH ENTRY
 ; THE RANGE 60-76, AND A VALUE OF 11110000 WOULD PROTECT 60-66.
 
 .RADIX	2
-	.BYTE	11111111,00111100,00001111,11110000 ;000-076
-	.BYTE	11000011,00000000,00000000,00000000 ;100-176
+;Omega: the vectors of the MS 0515's own devices too - 070, 130, 160, 164
+	.BYTE	11111111,00111100,00001111,11111100 ;000-076
+	.BYTE	11000011,00001100,00000000,11110000 ;100-176
 	.BYTE	00000000,00000000,00110000,00000000 ;200-276
-	.BYTE	00000000,00000000,00000000,00000000 ;300-376
+	.BYTE	11110000,11111111,00000000,00000000 ;300-376 (Omega: 300-306, 320-336)
 	.BYTE	00000000,00000000,00000000,00000000 ;400-476
 .RADIX	8.
 
