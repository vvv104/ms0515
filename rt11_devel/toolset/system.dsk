.MACRO	.DRDEF	NAME,CODE,STAT,SIZE,CSR,VEC
.MCALL	.DRAST,.DRBEG,.DRBOT,.DREND,.DREST,.DRFIN,.DRINS,.DRPTR
.MCALL	.DRSET,.DRSPF,.DRTAB,.V18!<MOD>
...V19=...V19!<MOD2>
.ASECT
