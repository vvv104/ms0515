# Conan host profile for the browser build (ms0515_web):
#   conan build . -pr:h profiles/emscripten -pr:b default --build=missing
# The Emscripten SDK comes from Conan Center as a tool requirement; the
# build lands in build/emscripten-release/ (web/dist/ inside is the site).
[settings]
os=Emscripten
arch=wasm
compiler=clang
compiler.version=20
compiler.libcxx=libc++
compiler.cppstd=20
build_type=Release

[tool_requires]
emsdk/3.1.73
# The dependencies of the browser build (fmt) are compiled with this same
# profile, so the build tools have to come from Conan too: a machine that
# has no cmake/ninja on PATH would otherwise fail inside the fmt build.
cmake/[>=3.25 <5]
ninja/[>=1.11]

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmake_layout:build_folder_vars=["settings.os", "settings.build_type"]
