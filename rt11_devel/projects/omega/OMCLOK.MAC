.SBTTL	OMCLOK	The clock interrupt: the timer and the floppy motor
;
; OMCLOK - at LKINT:: in RMONSJ, ahead of DEC's clock code.
;
; Each tick first reads the timer service address twice (NS4 names
; 177770 the halt and system-timer service address), then runs the
; floppy motor's time-out.  The ROM's disk code keeps its copy of System
; Register A (write-only) with three flags on top: bit 15 - the time-out
; is armed, bit 14 - the drive was just used, bit 13 - counting.  A
; fresh use restarts the count; 100 ticks later (two seconds at 50 Hz)
; the drive is deselected with its motor off (drive 3, bit 2 - the motor,
; active low - set) and the register written from the copy.  The clock
; interrupt goes on at priority 7 where DEC's drops to 6 ($INTEN's word).
;
TMRSVC	= 177770	;Timer service address
SYSRGA	= 177600	;System Register A: drives, motor, side
RGACPY	= 157720	;The ROM's copy of it, flags in bits 13-15
MT$ARM	= 100000	;The time-out is armed
MT$NEW	= 40000		;The drive was just used
MT$CNT	= 20000		;Counting
MT$OFF	= 17		;Drive 3, motor off, upper side

.MACRO	OMCLOK	?A,?B,?C
	NOP
	NOP
	TST	@#TMRSVC
	TST	@#TMRSVC
	TST	@#RGACPY	;Armed?
	BPL	B
	BIT	#MT$NEW,@#RGACPY ;Used since the last tick?
	BEQ	A
	BIC	#MT$NEW,@#RGACPY ;Yes: count afresh
	BIS	#MT$CNT,@#RGACPY
	CLR	(PC)+
C:	 .WORD	0		;The ticks counted
A:	BIT	#MT$CNT,@#RGACPY
	BEQ	B
	INC	C
	CMP	#100.,C		;Two seconds yet?
	BHIS	B
	BIC	#MT$CNT,@#RGACPY ;Yes: the motor off
	BIS	#MT$OFF,@#RGACPY
	MOVB	@#RGACPY,@#SYSRGA
B:
.ENDM	OMCLOK
