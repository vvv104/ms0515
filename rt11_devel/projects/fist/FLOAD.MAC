        .TITLE  FLOAD
;-------------------------------------------------------------------
; FLOAD - the loader FIST ships as its .SAV.
;
; An RT-11 .SAV is a memory image from address 0, so every hole in the
; program's address map is stored on disk.  FIST's image is 38400 bytes
; of which 11194 are holes and buffers it never reads, so the program
; travels in FIST.DAT instead (source/pack_fist.py appends it there,
; LZSS-packed) and this reads it back.  The regions follow each other
; byte for byte and the table sits at the very end of the file:
;
;       (load address, word count, start block, byte offset into it,
;       packed length) per region, then the image's top - what this
;       clears up to - and the count as the last word
;
; and .LOOKUP hands back the file's length, so nothing here has to be
; told where the table is.
;
; WHERE THIS WORKS, AND WHY IT TAKES SO MUCH CARE
;
; It used to keep its working set in the hole in the game's own map,
; 057600..077777, on the argument that the game never touches it.  The
; game does not - but RT-11 might, and on Rodionov's RT15SJ it does:
; parts of that monitor start at 072000, so the loader wrote over the
; monitor it still needed and the next read went nowhere.
;
; Nothing is assumed about the monitor's whereabouts now.  Everything
; the loader needs is either inside its own image - which RT-11
; guarantees is the program's - or in the EXTENDED banks, which the
; monitor cannot see at all.  The dispatcher picks primary or extended
; per 8 KB bank, so an extended bank can be ours while the code in bank
; 0 and the region being expanded home stay primary.  Three uses:
;
;       extended bank 3 (060000..077777)      the scratch: packed bytes
;                                             and the picture, first
;       extended banks 4..6 (0100000..0157777) the GST, where the game
;                                             reads it
;       extended bank 2 (040000..057777)      the last region, expanded
;
; The last region covers 01000, where this runs, so it goes last: it is
; expanded into extended bank 2, and a copier planted in the free bytes
; between the vectors and 01000 - part of no region, and primary in
; every mapping - moves it down and enters the game.
;-------------------------------------------------------------------
        .MCALL  .LOOKUP,.PRINT,.EXIT
        .ASECT
        . = 44
        .WORD   21000                  ; JSW: this .SAV does file I/O
        . = 1000

DISPAT = 177400                        ; the memory dispatcher
SYSC   = 177604                        ; System Register C (border + video mode)
DPRIM  = 2177                          ; every bank primary - RT-11's own setting
DEXT3  = 2167                          ; bank 3 extended: the scratch
DEXT23 = 2163                          ; banks 2 and 3 extended: the scratch and
                                       ;   the room the last region expands into
DEXT2  = 2173                          ; bank 2 alone, for the copy down
DPIC   = 6367                          ; bank 3 extended, VRAM on at 0100000
DGST   = 2007                          ; banks 3..6 extended: the scratch and
                                       ;   the GST's home together
GSTBAS = 100000                        ; where the game reads the GST, in the
                                       ;   extended banks
SCRAT  = 60000                         ; extended bank 3: packed bytes land here,
                                       ;   and the picture expands here first
EXPBUF = 40000                         ; extended bank 2: the last region, expanded.
                                       ;   Not bank 5 - the GST lives in 4, 5 and 6 -
                                       ;   and not banks 0 or 1, where it lands.
VRAMW  = 100000                        ; the VRAM window while the picture goes up
LOWST  = 400                           ; the copier: past the vectors, below 01000
LMARG  = 8.                            ; the picture is 256 px in 320: 8 bytes in
TMARG  = 4.                            ;   and 192 lines in 200: 4 lines down
RDW    = 4001                          ; .READW, channel 1 (code 8 in the high byte)
; Channel 1, not 0: the game opens 0 for itself the moment it starts, and
; a channel still in use would fail its .LOOKUP.

START:  MOV     #STACK,SP
        JSR     PC,TITLE1              ; the picture, before anything is read
        .LOOKUP #LKAREA,#1,#DATFIL
        BCC     1$
        JMP     ERR
1$:     DEC     R0                     ; R0 = the file's length; the table is last
        MOV     #TABBUF,R1
        MOV     R0,R3
        JSR     PC,RDBLK1              ; the table block, into our own image

        ; Low memory is the monitor's: the words the image carries below
        ; 01000 are LINK's own bookkeeping (start address, high limit, JSW)
        ; and RT-11 sets them when it loads a .SAV.  Clearing them here took
        ; 054 - the pointer to RMON - with them, and the next EMT went
        ; nowhere.  So low memory is neither cleared nor loaded.
        MOV     #LOADND,R0
        MOV     #57600,R1
        JSR     PC,ZERO
        MOV     #100000,R0
        MOV     TABBUF+774,R1          ; the image's top, from the table: the
        JSR     PC,ZERO                ;   buffers up there are .BLKB, never
                                       ;   stored, and the game wants them zero

        ; The table's two halves, from the end of the block: the count of
        ; program regions, the image's top, those regions, the count of GST
        ; pieces, and the GST's pieces.
        MOV     #TABBUF+774,R4         ; the top; the count is the word after
        MOV     2(R4),R5               ; how many program regions
        MOV     R5,R0
        JSR     PC,TENB
        SUB     R0,R4                  ; the first program entry
        MOV     R4,-(SP)               ; keep it: the GST comes first
        MOV     R5,-(SP)

        ; The GST: expanded into the extended banks, where the game reads it.
        ; Nothing of the monitor's is touched - the banks are invisible to it.
        MOV     -(R4),R5               ; how many GST pieces
        MOV     R5,R0
        JSR     PC,TENB
        SUB     R0,R4                  ; the first GST entry
21$:    MOV     (R4)+,EADR             ; a byte offset into the GST
        MOV     (R4)+,ECNT
        MOV     (R4)+,EBLK
        MOV     (R4)+,EOFF
        MOV     (R4)+,ELEN
        MOV     R4,-(SP)
        MOV     R5,-(SP)
        JSR     PC,FETCH
        MOV     #DGST,@#DISPAT
        MOV     #SCRAT,R1
        ADD     EOFF,R1
        MOV     EADR,R2
        ADD     #GSTBAS,R2
        MOV     ECNT,R3
        ASL     R3
        JSR     PC,PIC
        MOV     #DPRIM,@#DISPAT
        MOV     (SP)+,R5
        MOV     (SP)+,R4
        SOB     R5,21$

        MOV     (SP)+,R5               ; back to the program's regions
        MOV     (SP)+,R4

        ; Every region but the one that covers this loader.  That one is
        ; remembered by its entry: the table block is in our own image and
        ; outlives everything but the last copy.
3$:     MOV     R4,ENT
        MOV     (R4)+,EADR
        MOV     (R4)+,ECNT
        MOV     (R4)+,EBLK
        MOV     (R4)+,EOFF
        MOV     (R4)+,ELEN
        CMP     EADR,#1000
        BLO     5$                     ; below 01000: the monitor's, leave it
        BNE     4$
        MOV     ENT,KENT               ; ours: it goes last
        BR      5$
4$:     MOV     R4,-(SP)               ; the decoder uses every register,
        MOV     R5,-(SP)               ;   and these two are the table walk
        JSR     PC,PLACE
        MOV     (SP)+,R5
        MOV     (SP)+,R4
5$:     SOB     R5,3$

        ; The last region: read it aside and expand it into extended bank 2,
        ; out of the way of the copy that follows.
        MOV     KENT,R0
        MOV     (R0)+,EADR
        MOV     (R0)+,ECNT
        MOV     (R0)+,EBLK
        MOV     (R0)+,EOFF
        MOV     (R0),ELEN
        JSR     PC,FETCH               ; its packed bytes into the scratch
        MOV     #DEXT23,@#DISPAT
        MOV     #SCRAT,R1
        ADD     EOFF,R1
        MOV     #EXPBUF,R2
        MOV     ECNT,R3
        ASL     R3
        JSR     PC,PIC
        MOV     #DPRIM,@#DISPAT

        ; The copier into low memory - past the vectors, below 01000: it is
        ; part of no region and primary in every mapping, so it survives
        ; both the bank switch and the region landing on this loader.
        MOV     #COPY,R0
        MOV     #LOWST,R1
        MOV     #<COPYE-COPY>/2,R2
2$:     MOV     (R0)+,(R1)+
        SOB     R2,2$
        MOV     ECNT,R3                ; words to move down
        JMP     @#LOWST

        ; PLACE: the region in the E cells, read aside and expanded home.
PLACE:  JSR     PC,FETCH
        MOV     #DEXT3,@#DISPAT
        MOV     #SCRAT,R1
        ADD     EOFF,R1                ; the packed bytes start here
        MOV     EADR,R2
        MOV     ECNT,R3
        ASL     R3                     ;   as bytes
        JSR     PC,PIC
        MOV     #DPRIM,@#DISPAT
        RTS     PC

        ; FETCH: the E region's packed bytes into the scratch, a block at a
        ; time - .READW writes to primary memory, so each block lands in our
        ; own image and is copied up into the extended bank.
FETCH:  MOV     EOFF,R0
        ADD     ELEN,R0
        ADD     #511.,R0
        ASR     R0                     ; R0 = blocks the region spans:
        ASR     R0                     ;   nine shifts, because ASH is an
        ASR     R0                     ;   EIS instruction and this machine
        ASR     R0                     ;   need not have it
        ASR     R0
        ASR     R0
        ASR     R0
        ASR     R0
        ASR     R0
        MOV     R0,FBLKS
        MOV     EBLK,FBLK
        MOV     #SCRAT,FDST
6$:     MOV     #BLKBUF,R1
        MOV     FBLK,R3
        JSR     PC,RDBLK1
        MOV     #DEXT3,@#DISPAT
        MOV     #BLKBUF,R0
        MOV     FDST,R1
        MOV     #256.,R2
7$:     MOV     (R0)+,(R1)+
        SOB     R2,7$
        MOV     R1,FDST
        MOV     #DPRIM,@#DISPAT
        INC     FBLK
        DEC     FBLKS
        BGT     6$
        RTS     PC

        ; RDBLK1: one block, R1 = where (primary), R3 = which.  Keeps R4/R5.
RDBLK1: MOV     R4,-(SP)
        MOV     R5,-(SP)
        MOV     #LKAREA,R5
        MOV     #RDW,(R5)
        MOV     R3,2(R5)
        MOV     R1,4(R5)
        MOV     #256.,6(R5)
        CLR     10(R5)
        MOV     R5,R0
        EMT     375
        BCS     8$
        MOV     (SP)+,R5
        MOV     (SP)+,R4
        RTS     PC
8$:     JMP     ERR

        ; TENB: R0 = ten times R0 - an entry is ten bytes.
TENB:   ASL     R0                     ; 2n
        MOV     R0,R1
        ASL     R1
        ASL     R1                     ; 8n
        ADD     R1,R0                  ; 10n
        RTS     PC

        ; ZERO: R0 = from, R1 = to (exclusive).
ZERO:   CMP     R0,R1
        BHIS    9$
        CLR     (R0)+
        BR      ZERO
9$:     RTS     PC

        ; TITLE1: expand the packed loading screen - it ships inside this
        ; loader - into extended bank 3 and convert it into VRAM.  Neither
        ; is memory RT-11 owns, so the picture goes up before a block is
        ; read and stays up through the whole load.
TITLE1: MOV     #DEXT3,@#DISPAT
        MOV     #SCRPK,R1
        MOV     #SCRAT,R2
        MOV     #SCRRAW,R3
        JSR     PC,PIC                 ; the decoder is in our image, bank 0
        MTPS    #340
        MOVB    @#SYSC,R0
        BIC     #17,R0                 ; medium resolution, colour
        MOVB    R0,@#SYSC
        MOV     #DPIC,@#DISPAT         ; + VRAM at 0100000, bank 3 still ours
        MOV     #VRAMW,R0              ; the cyan margins the game paints
10$:    MOV     #24000,(R0)+
        CMP     R0,#VRAMW+16384.
        BLO     10$
        CLR     R5                     ; R5 = the Spectrum line, 0..191
11$:    MOV     R5,R0
        JSR     PC,ROWOFF              ; R1 = the line's offset in the pixels
        ADD     #SCRAT,R1
        MOV     R5,R2                  ; the attribute row: 6144 + (y>>3)*32
        ASR     R2
        ASR     R2
        ASR     R2
        ASL     R2
        ASL     R2
        ASL     R2
        ASL     R2
        ASL     R2
        ADD     #SCRAT+6144.,R2
        MOV     R5,R3                  ; the VRAM line: (TMARG + y) * 80
        ADD     #TMARG,R3
        MOV     R3,R0
        ASL     R0
        ASL     R0
        ASL     R0
        ASL     R0                     ; * 16
        MOV     R0,R4
        ASL     R0
        ASL     R0                     ; * 64
        ADD     R4,R0                  ; * 80
        ADD     #VRAMW+LMARG,R0
        MOV     R0,R3
        MOV     #32.,R4                ; 32 cells across
12$:    CLR     R0
        BISB    (R2)+,R0
        SWAB    R0                     ; the attribute is the high byte
        BISB    (R1)+,R0               ;   and the pixels the low one
        MOV     R0,(R3)+
        DEC     R4
        BNE     12$
        INC     R5
        CMP     R5,#192.
        BLO     11$
        MOV     #DPRIM,@#DISPAT        ; the window closes; the picture stays
        MTPS    #0
        RTS     PC

        ; ROWOFF: R0 = the Spectrum line, R1 = its offset in the pixel area.
ROWOFF: MOV     R0,R1
        BIC     #177770,R1
        SWAB    R1                     ; (y & 7) << 8
        MOV     R0,-(SP)
        BIC     #177707,(SP)
        ASL     (SP)
        ASL     (SP)
        BIS     (SP)+,R1               ; | (y & 070) << 2
        MOV     R0,-(SP)
        BIC     #177477,(SP)
        ASL     (SP)
        ASL     (SP)
        ASL     (SP)
        ASL     (SP)
        ASL     (SP)
        BIS     (SP)+,R1               ; | (y & 0300) << 5
        RTS     PC

ERR:    .PRINT  #EMSG
        .EXIT

        ; The decoder: R1 = packed bytes, R2 = where to put them, R3 = bytes
        ; to produce.  LZSS - a flag byte, then eight items, low bit first:
        ; a set bit is a literal byte, a clear one two bytes giving a
        ; distance of up to 4095 and a length of 3..18.  A match copies from
        ; what is already written, so a run comes out by itself.
PIC:    TST     R3
        BEQ     19$
13$:    CLR     R5
        BISB    (R1)+,R5
        BIS     #400,R5                ; a sentinel above the eight flags
14$:    ASR     R5                     ; C = this item's flag
        BCC     15$
        MOVB    (R1)+,(R2)+            ; a literal byte
        DEC     R3
        BR      18$
15$:    CLR     R0
        BISB    (R1)+,R0               ; the distance, low eight bits
        CLR     R4
        BISB    (R1)+,R4               ; its top four, and the length
        MOV     R4,-(SP)
        BIC     #177417,R4             ; the high nibble alone
        ASL     R4
        ASL     R4
        ASL     R4
        ASL     R4                     ; into bits 11..8
        ADD     R4,R0                  ; R0 = the distance
        MOV     (SP)+,R4
        BIC     #177760,R4             ; the length nibble
        ADD     #3,R4                  ; 3..18
        MOV     R2,-(SP)
        SUB     R0,(SP)
        MOV     (SP)+,R0               ; where to copy from
16$:    MOVB    (R0)+,(R2)+
        DEC     R3
        BEQ     19$
        SOB     R4,16$
18$:    TST     R3
        BEQ     19$
        CMP     R5,#1                  ; the sentinel down to bit 0: eight done
        BNE     14$
        BR      13$
19$:    RTS     PC

        ; The copier, moved to LOWST and run there: R3 = words.  It brings
        ; the last region down out of extended bank 2 and enters the game.
        ; Nothing here is PC-relative, and low memory is primary whatever
        ; the dispatcher says, so it survives its own bank switches.
COPY:   MOV     #DEXT2,@#DISPAT
        MOV     #EXPBUF,R0
        MOV     #1000,R1
20$:    MOV     (R0)+,(R1)+
        SOB     R3,20$
        MOV     #DPRIM,@#DISPAT
        JMP     @#1000
COPYE:

ENT:    .WORD   0
EADR:   .WORD   0
ECNT:   .WORD   0
EBLK:   .WORD   0
EOFF:   .WORD   0
ELEN:   .WORD   0
KENT:   .WORD   0
FBLK:   .WORD   0
FBLKS:  .WORD   0
FDST:   .WORD   0
        .EVEN
DATFIL: .RAD50  /DK FIST  DAT/
        .EVEN
LKAREA: .BLKW   5
EMSG:   .ASCIZ  /?FLOAD-F-Cannot read FIST.DAT/
        .EVEN
        .BLKW   64.                    ; the stack, inside our own image: the
STACK:                                 ;   only primary memory RT-11 promises
BLKBUF: .BLKW   256.                   ; one block, where .READW can reach it
TABBUF: .BLKW   256.                   ; the table block, kept for the walk
LOADND:
; The picture's packed bytes follow, from FSCRN.MAC, and it ends the
; assembly: `.END` here would cut them off.  It also defines PICBUF.
