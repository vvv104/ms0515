.SBTTL	SYCDEC	DEC'S RT-11 SJ ON THE MS 0515: THE CONDITIONAL FILE
;
; DEC's own answers - its distributed SJ monitor's, SJFB.CND - as far as
; the machine allows: no FPU (the T-11 has none), none of DEC's devices
; (the device tables are DEVTBL's, the machine's), a 50-cycle clock (the
; machine's frame).  No SYSG$N: like DEC's distributed monitor, the banner
; has no "(S)".  No SJ timer support, as DEC's: the console through the ROM
; sits in DEC's terminal code without it the way OSA's monitor has it.
; Only what the machine needs of the kits' changes (OM$EXA).
;
RDF$L	= 1		;System I/O error messages
TTYOUT  = 40.		;Size of the output buffers
TTYIN   = 134.		;Size of the input buffers
U$CL	= 1		;User command linkage
U$TIL	= 1		;Utility commands
L$ANG	= 1		;Language commands
M$INI	= 1		;Minimal commands
CLOCK	= 50.		;Power line frequency (the MS 0515's frame)
STAR$T	= 1		;Startup command file
OM$EXA	= 0		;This build: DEC's RT-11 on the MS 0515 (see OMEGA.MAC)
